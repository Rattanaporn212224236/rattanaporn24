# ------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น ".env" แล้วปรับค่าตามเครื่องของคุณ (XAMPP/MySQL จริง)
# ------------------------------------------------------------------

# ฐานข้อมูล MySQL (kuse_event) - ค่าเริ่มต้นตรงกับ XAMPP ทั่วไป (root, ไม่มีรหัสผ่าน)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kuse_event

# ความปลอดภัยของ JWT token - ควรเปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# พอร์ตที่ Express API server จะรัน
PORT=5000

# โดเมนของหน้าเว็บแอดมิน (Vite dev server) ที่อนุญาตให้เรียก API ได้ (CORS)
CORS_ORIGIN=http://localhost:5173

# ใช้โดยฝั่ง React (Vite) เพื่อรู้ว่าจะยิง API ไปที่ไหน
VITE_API_URL=http://localhost:5000/api
