# ------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น ".env" แล้วปรับค่าตามเครื่องของคุณ (XAMPP/MySQL จริง)
# ------------------------------------------------------------------

# ฐานข้อมูล MySQL (kuse_event) - ค่าเริ่มต้นตรงกับ XAMPP ทั่วไป (root, ไม่มีรหัสผ่าน)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kuse_event

# ความปลอดภัยของ JWT token (ใช้เฉพาะฝั่งแอดมิน/เว็บ) - ควรเปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง
JWT_SECRET=kuse-event-secret-please-change-in-production
JWT_EXPIRES_IN=8h

# พอร์ตที่ API กลางจะรัน (ทั้งเว็บแอดมินและแอป Expo ยิงมาที่พอร์ตเดียวกันนี้)
PORT=5000

# ---- CORS ----
# Origin หลักของเว็บแอดมิน (Vite dev server) - อนุญาตเสมอ
CORS_ORIGIN=http://localhost:5173
# Origin เพิ่มเติม คั่นด้วย comma (ไม่จำเป็นต้องใส่ก็ได้ เพราะ localhost ทุกพอร์ต และ IP วง LAN
# ส่วนตัว (192.168.x.x / 10.x.x.x / 172.16-31.x.x) ทุกพอร์ตถูกอนุญาตอัตโนมัติอยู่แล้ว
# เผื่อกรณีพิเศษ เช่น เปิดผ่านโดเมนจริง หรือ ngrok/tunnel)
CORS_EXTRA_ORIGINS=

# ---- (ไม่จำเป็นต้องตั้ง ปกติปล่อยว่างไว้) ----
# URL ของ API ตัวเอง ใช้สร้างลิงก์รูปภาพเฉพาะตอนไม่มี request object ให้อ้างอิง (เช่น เรียกจาก
# สคริปต์ background) ปกติ API จะสร้างลิงก์รูปจาก host ที่ client เรียกเข้ามาจริงโดยอัตโนมัติอยู่แล้ว
# (รองรับ localhost/IP วง LAN/tunnel เองโดยไม่ต้องตั้งค่านี้)
ADMIN_SERVER_URL=
